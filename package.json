{
  "name": "komari-theme-YS",
  "private": true,
  "version": "1.5.3",
  "type": "module",
  "description": "Komari network asset monitoring theme",
  "author": "YS",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "node scripts/package-zip.mjs",
    "package:network": "npm run build && node scripts/package-zip.mjs --output komari-network-theme.zip --force",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.80.7",
    "clsx": "^2.1.1",
    "globe.gl": "^2.46.1",
    "lucide-react": "^0.473.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0",
    "three": "^0.184.0",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
